{
  "name": "site-ctrl-s",
  "version": "1.0.0",
  "description": "Site Ctrl+S – manutenção de computadores",
  "private": true,
  "scripts": {
    "lint:html": "htmlhint index.html",
    "build:css": "tailwindcss -i assets/css/input.css -o assets/css/tailwind.css --minify",
    "validate": "npm run lint:html && npm run build:css && npx lhci autorun --config=./lighthouserc.json",
    "deploy:netlify": "./scripts/deploy-netlify.sh"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "autoprefixer": "^10.4.23",
    "htmlhint": "^1.9.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19"
  }
}
